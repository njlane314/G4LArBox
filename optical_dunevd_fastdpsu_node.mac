/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/verbose 0

# Direct optical-photon smoke sample in the DUNE VD FastDPSU marker GDML.
# The source is in the LAr envelope just below a representative node's
# volOpDetSensitive_FastDPSU tile at approximately
# x=90.08 cm, y=225.19 cm, z=3003.55 cm.
/gps/particle opticalphoton
/gps/pos/type Point
/gps/pos/centre 90.08 225.00 3003.55 cm
/gps/ang/type beam1d
/gps/direction 0 1 0
/gps/polarization 1 0 0
/gps/ene/type Mono
/gps/ene/mono 2.88 eV

/run/beamOn 50
