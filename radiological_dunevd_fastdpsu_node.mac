# DUNE VD FastDPSU radiological background-only run.
# Use with dunevd_fastdpsu_paper.mac as the detector macro and
# G4LARBOX_FAST_OPTICAL=1 G4LARBOX_FAST_OPTICAL_MODEL=node.
#
# The 39Ar activity uses the atmospheric-argon value 1.01 Bq/kg.
# For a 10 kt active mass and a 10 us acquisition window this gives
# about 101 39Ar decays per event before Poisson fluctuations.
/generator/type radiological
/generator/radiological/window 10 us
/generator/radiological/massOverrideKg 10000000
/generator/radiological/maxDecaysPerEvent 250
/generator/radiological/clear
/generator/radiological/addIsotope Ar39 18 39 1.01 0.0
/generator/radiological/addIsotope Ar42 18 42 0.0000404 0.0
/run/beamOn 5
