<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal fast-dSiPM/DPSU optical node fragment for DUNE VD studies.

  This fragment defines reusable solids and logical volumes only. It does not
  place the nodes. For first optical-response tests, both housing and sensitive
  volume use LAr so the node starts as a near-massless optical marker.
-->
<gdml>
  <solids>
    <box name="FastDPSUHousingSolid" lunit="cm" x="3.0" y="3.0" z="3.0"/>
    <box name="FastDPSUSensitiveSolid" lunit="cm" x="0.10" y="1.0" z="1.0"/>
  </solids>

  <structure>
    <volume name="volOpDetSensitive_FastDPSU">
      <materialref ref="LAr"/>
      <solidref ref="FastDPSUSensitiveSolid"/>
      <auxiliary auxtype="SensDet" auxvalue="PhotonDetector"/>
    </volume>

    <volume name="volFastDPSUHousing">
      <materialref ref="LAr"/>
      <solidref ref="FastDPSUHousingSolid"/>
      <physvol>
        <volumeref ref="volOpDetSensitive_FastDPSU"/>
        <position name="posFastDPSUSensitiveFace" unit="cm" x="1.4499" y="0" z="0"/>
      </physvol>
    </volume>
  </structure>
</gdml>
