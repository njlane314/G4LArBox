<?xml version="1.0" encoding="ASCII"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position unit="cm" name="center" x="0" y="0" z="0"/>
    <rotation unit="degree" name="identity" x="0" y="0" z="0"/>
    <position unit="cm" name="WLS_pos" x="0.2325" y="0.0" z="-0.005"/>
    <position unit="cm" name="DCM_pos_inner" x="0.2325" y="0.0" z="0.5005"/>
    <position unit="cm" name="DCM_pos_outer" x="0.2325" y="0.0" z="-0.5105"/>
    <position unit="cm" name="TPB_pos" x="0.2325" y="0.0" z="0.511"/>
    <position unit="cm" name="SiPM_Mask_pos_0" x="-22.74885" y="-9.986633333333334" z="-0.005"/>
    <position unit="cm" name="SiPM_Mask_pos_1" x="-22.74885" y="0.0" z="-0.005"/>
    <position unit="cm" name="SiPM_Mask_pos_2" x="-22.74885" y="9.986633333333334" z="-0.005"/>
    <position unit="cm" name="SiPM_Sens_pos_0" x="-22.89875" y="-12.336633333333333" z="0"/>
    <position unit="cm" name="SiPM_Sens_pos_1" x="-22.89875" y="-7.636633333333333" z="0"/>
    <position unit="cm" name="SiPM_Sens_pos_2" x="-22.89875" y="-2.35" z="0"/>
    <position unit="cm" name="SiPM_Sens_pos_3" x="-22.89875" y="2.35" z="0"/>
    <position unit="cm" name="SiPM_Sens_pos_4" x="-22.89875" y="7.636633333333333" z="0"/>
    <position unit="cm" name="SiPM_Sens_pos_5" x="-22.89875" y="12.336633333333333" z="0"/>
    <position unit="cm" name="SiPM_pos_0" x="0.009" y="-2.35" z="0"/>
    <position unit="cm" name="SiPM_pos_1" x="0.009" y="2.35" z="0"/>
    <position unit="cm" name="SiPM_PCB_pos_0" x="-22.98135" y="-9.986633333333334" z="-0.005"/>
    <position unit="cm" name="SiPM_PCB_pos_1" x="-22.98135" y="0.0" z="-0.005"/>
    <position unit="cm" name="SiPM_PCB_pos_2" x="-22.98135" y="9.986633333333334" z="-0.005"/>
  </define>

  <materials>
    <element name="hydrogen" formula="H" Z="1"><atom value="1.00794"/></element>
    <element name="carbon" formula="C" Z="6"><atom value="12.0107"/></element>
    <element name="nitrogen" formula="N" Z="7"><atom value="14.0067"/></element>
    <element name="oxygen" formula="O" Z="8"><atom value="15.999"/></element>
    <element name="argon" formula="Ar" Z="18"><atom value="39.948"/></element>
    <element name="silicon" formula="Si" Z="14"><atom value="28.0855"/></element>
    <element name="boron" formula="B" Z="5"><atom value="10.811"/></element>
    <element name="aluminum" formula="Al" Z="13"><atom value="26.9815"/></element>
    <element name="sodium" formula="Na" Z="11"><atom value="22.9898"/></element>
    <element name="potassium" formula="K" Z="19"><atom value="39.0983"/></element>
    <element name="zinc" formula="Zn" Z="30"><atom value="65.409"/></element>
    <element name="titanium" formula="Ti" Z="22"><atom value="47.867"/></element>

    <material name="Air" state="gas">
      <D value="0.001205" unit="g/cm3"/>
      <fraction ref="nitrogen" n="0.781154"/>
      <fraction ref="oxygen" n="0.209476"/>
      <fraction ref="argon" n="0.00937"/>
    </material>
    <material name="LAr" state="liquid">
      <D value="1.40" unit="g/cm3"/>
      <composite ref="argon" n="1"/>
    </material>
    <material name="Epoxy">
      <D value="1.18" unit="g/cm3"/>
      <composite ref="carbon" n="21"/>
      <composite ref="hydrogen" n="25"/>
      <composite ref="oxygen" n="5"/>
    </material>
    <material name="Glass">
      <D value="2.7" unit="g/cm3"/>
      <fraction ref="silicon" n="0.2743"/>
      <fraction ref="boron" n="0.0166"/>
      <fraction ref="aluminum" n="0.0207"/>
      <fraction ref="sodium" n="0.0449"/>
      <fraction ref="potassium" n="0.0821"/>
      <fraction ref="zinc" n="0.0882"/>
      <fraction ref="titanium" n="0.0292"/>
      <fraction ref="oxygen" n="0.444"/>
    </material>
    <material name="FR4">
      <D value="1.85" unit="g/cm3"/>
      <fraction ref="Epoxy" n="0.206"/>
      <fraction ref="Glass" n="0.794"/>
    </material>
    <material name="Silicon">
      <D value="2.33" unit="g/cm3"/>
      <composite ref="silicon" n="1"/>
    </material>
    <material name="EJ280WLS">
      <D value="1.023" unit="g/cm3"/>
      <composite ref="carbon" n="9"/>
      <composite ref="hydrogen" n="10"/>
    </material>
    <material name="PVT">
      <D value="1.023" unit="g/cm3"/>
      <composite ref="carbon" n="9"/>
      <composite ref="hydrogen" n="10"/>
    </material>
    <material name="PSA">
      <D value="1.18" unit="g/cm3"/>
      <composite ref="carbon" n="4"/>
      <composite ref="hydrogen" n="6"/>
      <composite ref="oxygen" n="2"/>
    </material>
  </materials>

  <solids>
    <box name="world_box" lunit="cm" x="65" y="45" z="25"/>
    <box name="ArCLight" lunit="cm" x="46.2627" y="29.9599" z="1.032"/>
    <box name="WLS_panel_shape" lunit="cm" x="45.7977" y="29.9599" z="1.0"/>
    <box name="DCM_shape" lunit="cm" x="45.7977" y="29.9599" z="0.011"/>
    <box name="TPB_LAr_shape" lunit="cm" x="45.7977" y="29.9599" z="0.010"/>
    <box name="SiPM_Mask_shape" lunit="cm" x="0.165" y="7.825" z="1.0"/>
    <box name="SiPM_Sens_shape" lunit="cm" x="0.0002" y="0.6000" z="0.6000"/>
    <box name="SiPM_shape" lunit="cm" x="0.147" y="0.6000" z="0.6000"/>
    <box name="SiPM_PCB_shape" lunit="cm" x="0.3000" y="9.986633333333334" z="1.0"/>
  </solids>

  <structure>
    <volume name="volSiPM_Sens">
      <materialref ref="Silicon"/>
      <solidref ref="SiPM_Sens_shape"/>
    </volume>
    <volume name="volWLS">
      <materialref ref="EJ280WLS"/>
      <solidref ref="WLS_panel_shape"/>
      <physvol><volumeref ref="volSiPM_Sens"/><positionref ref="SiPM_Sens_pos_0"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="1"><volumeref ref="volSiPM_Sens"/><positionref ref="SiPM_Sens_pos_1"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="2"><volumeref ref="volSiPM_Sens"/><positionref ref="SiPM_Sens_pos_2"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="3"><volumeref ref="volSiPM_Sens"/><positionref ref="SiPM_Sens_pos_3"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="4"><volumeref ref="volSiPM_Sens"/><positionref ref="SiPM_Sens_pos_4"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="5"><volumeref ref="volSiPM_Sens"/><positionref ref="SiPM_Sens_pos_5"/><rotationref ref="identity"/></physvol>
    </volume>
    <volume name="volDCM">
      <materialref ref="PSA"/>
      <solidref ref="DCM_shape"/>
    </volume>
    <volume name="volTPB_LAr">
      <materialref ref="LAr"/>
      <solidref ref="TPB_LAr_shape"/>
    </volume>
    <volume name="volSiPM">
      <materialref ref="Silicon"/>
      <solidref ref="SiPM_shape"/>
    </volume>
    <volume name="volSiPM_Mask">
      <materialref ref="PVT"/>
      <solidref ref="SiPM_Mask_shape"/>
      <physvol><volumeref ref="volSiPM"/><positionref ref="SiPM_pos_0"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="1"><volumeref ref="volSiPM"/><positionref ref="SiPM_pos_1"/><rotationref ref="identity"/></physvol>
    </volume>
    <volume name="volSiPM_PCB">
      <materialref ref="FR4"/>
      <solidref ref="SiPM_PCB_shape"/>
    </volume>
    <volume name="volArCLight">
      <materialref ref="LAr"/>
      <solidref ref="ArCLight"/>
      <physvol><volumeref ref="volWLS"/><positionref ref="WLS_pos"/><rotationref ref="identity"/></physvol>
      <physvol><volumeref ref="volDCM"/><positionref ref="DCM_pos_inner"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="1"><volumeref ref="volDCM"/><positionref ref="DCM_pos_outer"/><rotationref ref="identity"/></physvol>
      <physvol><volumeref ref="volTPB_LAr"/><positionref ref="TPB_pos"/><rotationref ref="identity"/></physvol>
      <physvol><volumeref ref="volSiPM_Mask"/><positionref ref="SiPM_Mask_pos_0"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="1"><volumeref ref="volSiPM_Mask"/><positionref ref="SiPM_Mask_pos_1"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="2"><volumeref ref="volSiPM_Mask"/><positionref ref="SiPM_Mask_pos_2"/><rotationref ref="identity"/></physvol>
      <physvol><volumeref ref="volSiPM_PCB"/><positionref ref="SiPM_PCB_pos_0"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="1"><volumeref ref="volSiPM_PCB"/><positionref ref="SiPM_PCB_pos_1"/><rotationref ref="identity"/></physvol>
      <physvol copynumber="2"><volumeref ref="volSiPM_PCB"/><positionref ref="SiPM_PCB_pos_2"/><rotationref ref="identity"/></physvol>
    </volume>
    <volume name="volWorld">
      <materialref ref="LAr"/>
      <solidref ref="world_box"/>
      <physvol><volumeref ref="volArCLight"/><positionref ref="center"/><rotationref ref="identity"/></physvol>
    </volume>
  </structure>

  <setup name="Default" version="0">
    <world ref="volWorld"/>
  </setup>
</gdml>
