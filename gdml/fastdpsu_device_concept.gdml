<?xml version='1.0' encoding='utf-8'?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="center" unit="cm" x="0" y="0" z="0" />
  </define>
  <materials>
    <element name="hydrogen" formula="H" Z="1">
      <atom value="1.00794" />
    </element>
    <element name="carbon" formula="C" Z="6">
      <atom value="12.0107" />
    </element>
    <element name="nitrogen" formula="N" Z="7">
      <atom value="14.0067" />
    </element>
    <element name="oxygen" formula="O" Z="8">
      <atom value="15.999" />
    </element>
    <element name="argon" formula="Ar" Z="18">
      <atom value="39.948" />
    </element>
    <element name="silicon" formula="Si" Z="14">
      <atom value="28.0855" />
    </element>
    <element name="copper" formula="Cu" Z="29">
      <atom value="63.546" />
    </element>
    <material name="Air" state="gas">
      <D value="0.001205" unit="g/cm3" />
      <fraction n="0.781154" ref="nitrogen" />
      <fraction n="0.209476" ref="oxygen" />
      <fraction n="0.00937" ref="argon" />
    </material>
    <material name="FR4_Approx">
      <D value="1.85" unit="g/cm3" />
      <fraction n="0.38" ref="carbon" />
      <fraction n="0.08" ref="hydrogen" />
      <fraction n="0.30" ref="oxygen" />
      <fraction n="0.24" ref="silicon" />
    </material>
    <material name="Silica">
      <D value="2.20" unit="g/cm3" />
      <fraction n="0.4674" ref="silicon" />
      <fraction n="0.5326" ref="oxygen" />
    </material>
    <material name="Silicon">
      <D value="2.33" unit="g/cm3" />
      <composite n="1" ref="silicon" />
    </material>
    <material name="Copper">
      <D value="8.96" unit="g/cm3" />
      <composite n="1" ref="copper" />
    </material>
  </materials>
  <solids>
    <box name="WorldSolid" lunit="cm" x="12" y="6" z="6" />
    <box name="PowerFiberSolid" lunit="cm" x="8" y="0.08" z="0.08" />
    <box name="SignalFiberSolid" lunit="cm" x="8" y="0.06" z="0.06" />
    <sphere name="SphericalNodeEnvelopeSolid" lunit="cm" aunit="deg" rmin="0" rmax="1.75" startphi="0" deltaphi="360" starttheta="0" deltatheta="180" />
    <box name="CarrierPlateSolid" lunit="cm" x="2.5" y="0.18" z="1.35" />
    <box name="ReadoutElectronicsSolid" lunit="cm" x="1.05" y="0.1" z="0.7" />
    <box name="SensitiveTileSolid" lunit="cm" x="0.75" y="0.1" z="0.65" />
    <box name="OpticalPowerConverterSolid" lunit="cm" x="0.48" y="0.14" z="0.28" />
    <box name="SiliconPhotonicsSolid" lunit="cm" x="0.48" y="0.14" z="0.28" />
    <box name="FiberFerruleSolid" lunit="cm" x="0.62" y="0.2" z="0.24" />
    <box name="FiberClipSolid" lunit="cm" x="3.6" y="0.08" z="0.12" />
  </solids>
  <structure>
    <volume name="volFastDPSUPowerFiber">
      <materialref ref="Silica" />
      <solidref ref="PowerFiberSolid" />
    </volume>
    <volume name="volFastDPSUSignalFiber">
      <materialref ref="Silica" />
      <solidref ref="SignalFiberSolid" />
    </volume>
    <volume name="volFastDPSUSphericalNode">
      <materialref ref="Silica" />
      <solidref ref="SphericalNodeEnvelopeSolid" />
    </volume>
    <volume name="volFastDPSUCarrierPlate">
      <materialref ref="FR4_Approx" />
      <solidref ref="CarrierPlateSolid" />
    </volume>
    <volume name="volFastDPSUReadoutElectronics">
      <materialref ref="Silicon" />
      <solidref ref="ReadoutElectronicsSolid" />
    </volume>
    <volume name="volOpDetSensitive_FastDPSU">
      <materialref ref="Silicon" />
      <solidref ref="SensitiveTileSolid" />
      <auxiliary auxtype="SensDet" auxvalue="PhotonDetector" />
    </volume>
    <volume name="volFastDPSUOpticalPowerConverter">
      <materialref ref="Silicon" />
      <solidref ref="OpticalPowerConverterSolid" />
    </volume>
    <volume name="volFastDPSUSiliconPhotonics">
      <materialref ref="Silicon" />
      <solidref ref="SiliconPhotonicsSolid" />
    </volume>
    <volume name="volFastDPSUFiberFerrule">
      <materialref ref="Silica" />
      <solidref ref="FiberFerruleSolid" />
    </volume>
    <volume name="volFastDPSUFiberClip">
      <materialref ref="FR4_Approx" />
      <solidref ref="FiberClipSolid" />
    </volume>
    <volume name="volWorld">
      <materialref ref="Air" />
      <solidref ref="WorldSolid" />
      <physvol>
        <volumeref ref="volFastDPSUPowerFiber" />
        <position name="posPowerFiber" unit="cm" x="0" y="-0.34" z="-0.82" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUSignalFiber" />
        <position name="posSignalFiber" unit="cm" x="0" y="-0.34" z="0.82" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUSphericalNode" />
        <position name="posSphericalNode" unit="cm" x="0" y="0" z="0" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUCarrierPlate" />
        <position name="posCarrierPlate" unit="cm" x="0" y="0" z="0" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUReadoutElectronics" />
        <position name="posReadoutElectronics" unit="cm" x="-0.15" y="-0.22" z="0" />
      </physvol>
      <physvol>
        <volumeref ref="volOpDetSensitive_FastDPSU" />
        <position name="posSensitiveTile" unit="cm" x="0" y="0.22" z="0" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUOpticalPowerConverter" />
        <position name="posOpticalPowerConverter" unit="cm" x="-0.58" y="0.25" z="-0.42" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUSiliconPhotonics" />
        <position name="posSiliconPhotonics" unit="cm" x="0.58" y="0.25" z="0.42" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUFiberFerrule" />
        <position name="posPowerFiberFerrule" unit="cm" x="-0.72" y="0.05" z="-0.78" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUFiberFerrule" />
        <position name="posSignalFiberFerrule" unit="cm" x="0.72" y="0.05" z="0.78" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUFiberClip" />
        <position name="posPowerFiberClip" unit="cm" x="0" y="0.42" z="-0.82" />
      </physvol>
      <physvol>
        <volumeref ref="volFastDPSUFiberClip" />
        <position name="posSignalFiberClip" unit="cm" x="0" y="0.42" z="0.82" />
      </physvol>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="volWorld" />
  </setup>
</gdml>