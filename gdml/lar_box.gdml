<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="center" unit="cm" x="0" y="0" z="0"/>
  </define>

  <materials>
    <element name="nitrogen" formula="N" Z="7">
      <atom value="14.0067"/>
    </element>

    <element name="oxygen" formula="O" Z="8">
      <atom value="15.999"/>
    </element>

    <element name="argon" formula="Ar" Z="18">
      <atom value="39.948"/>
    </element>

    <material name="LAr" formula="LAr" state="liquid">
      <D value="1.40" unit="g/cm3"/>
      <fraction n="1.0000" ref="argon"/>
    </material>

    <material name="Air" state="gas">
      <D value="0.001205" unit="g/cm3"/>
      <fraction n="0.781154" ref="nitrogen"/>
      <fraction n="0.209476" ref="oxygen"/>
      <fraction n="0.00937" ref="argon"/>
    </material>
  </materials>

  <solids>
    <box name="world_box" x="320" y="280" z="1120" lunit="cm"/>
    <!-- Matches TPCActive in ../ubcore/ubcore/Geometry/gdml/microboone/micro-tpc.gdml. -->
    <box name="lar_active_box" x="256.35" y="233" z="1036.8" lunit="cm"/>
  </solids>

  <structure>
    <volume name="volLArActive">
      <materialref ref="LAr"/>
      <solidref ref="lar_active_box"/>
    </volume>

    <volume name="volWorld">
      <materialref ref="Air"/>
      <solidref ref="world_box"/>
      <physvol name="pvLArActive">
        <volumeref ref="volLArActive"/>
        <positionref ref="center"/>
      </physvol>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="volWorld"/>
  </setup>
</gdml>
