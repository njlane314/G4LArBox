/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/verbose 0

# Short charged-particle sample in the DUNE VD FastDPSU geometry. Enable the
# node fast optical response with G4LARBOX_FAST_OPTICAL=1 and
# G4LARBOX_FAST_OPTICAL_MODEL=node when running this macro.
/gps/particle e-
/gps/pos/type Point
/gps/pos/centre 90.08 225.00 3003.55 cm
/gps/ang/type beam1d
/gps/direction 1 0 0
/gps/ene/type Mono
/gps/ene/mono 100 MeV

/run/beamOn 5
