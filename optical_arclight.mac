/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/verbose 0

# Smoke optical sample inside the standalone ArCLight WLS panel, close to one
# SiPM edge so a short run should record sensor crossings.
# 2.88 eV corresponds to roughly 430 nm light after wavelength shifting.
/gps/particle opticalphoton
/gps/pos/type Point
/gps/pos/centre -22.65 -2.35 0 cm
/gps/ang/type iso
/gps/polarization 1 0 0
/gps/ene/type Mono
/gps/ene/mono 2.88 eV

/run/beamOn 500
